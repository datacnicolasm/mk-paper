# LLM / LiteLLM — Groq es el provider principal
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Modelo principal (razonamiento / investigación)
LITELLM_MODEL=groq/llama-3.3-70b-versatile
# Modelo rápido/económico (tareas masivas)
LITELLM_FAST_MODEL=groq/llama-3.1-8b-instant
LLM_TEMPERATURE=0.2

# AWS (producción) o MinIO (local)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=mk-paper

# PostgreSQL
DATABASE_URL=postgresql://mkpaper:mkpaper@postgres:5432/mkpaper
POSTGRES_PASSWORD=mkpaper

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Literature APIs
# OpenAlex polite pool + Unpaywall (requerido para PDF OA)
UNPAYWALL_EMAIL=your.email@example.com
# Semantic Scholar Graph API key (opcional). Cuando la tengas, pégala aquí:
# SEMANTIC_SCHOLAR_API_KEY=tu_api_key_aqui
SEMANTIC_SCHOLAR_API_KEY=
HTTP_TIMEOUT_SECONDS=45
HTTP_MAX_RETRIES=4

# PDF full-text (OA papers)
PDF_FULLTEXT_ENABLED=true
PDF_MAX_PAGES=12
PDF_MAX_CHARS=14000
PDF_DOWNLOAD_CONCURRENCY=2

# Hybrid alignment (TF-IDF + cosine vs research profile)
ALIGNMENT_HIGH_THRESHOLD=0.35
ALIGNMENT_LOW_THRESHOLD=0.12
ALIGNMENT_MAX_FEATURES=12000

# Seminal / foundational literature (citas / años)
SEMINAL_MIN_AGE_YEARS=10
SEMINAL_CITES_PER_YEAR=50
SEMINAL_MIN_CITATIONS=500
SEMINAL_ALIGNMENT_FLOOR=0.04
SEMINAL_HISTORY_BOOST=0.15

# App — rutas Docker; en WSL/local se resuelven automáticamente a ./data, ./output, etc.
LOG_LEVEL=INFO
# WORKSPACE_DIR=/app/workspace
# OUTPUT_DIR=/app/output
# DATA_DIR=/app/data
