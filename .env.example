# LLM / LiteLLM
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
LITELLM_MODEL=gpt-4o
LITELLM_FAST_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct

# AWS (producción) o MinIO (local)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=mk-paper

# PostgreSQL
DATABASE_URL=postgresql://mkpaper:mkpaper@postgres:5432/mkpaper
POSTGRES_PASSWORD=mkpaper

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# App
LOG_LEVEL=INFO
WORKSPACE_DIR=/app/workspace
OUTPUT_DIR=/app/output
DATA_DIR=/app/data
