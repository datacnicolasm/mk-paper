{
  "title": "Realized volatility regression baseline",
  "task_type": "regression",
  "target": "realized_vol",
  "features": ["lag_vol", "momentum", "bid_ask_spread"],
  "controls": [],
  "dataset_path": "datasets/example_returns.csv",
  "literature_review_path": "literature/example_review_for_analysis.json",
  "test_size": 0.2,
  "cv_folds": 3,
  "random_state": 42,
  "primary_metric": "rmse",
  "models": ["ols", "ridge"],
  "hyperparameter_grids": {
    "ridge": {
      "alpha": [0.01, 0.1, 1.0, 10.0]
    }
  },
  "max_grid_combinations": 20,
  "literature_benchmarks": [
    {
      "metric": "rmse",
      "reference_value": 0.01,
      "higher_is_better": false,
      "source": "synthetic-lit-baseline / example review",
      "note": "Illustrative RMSE reported for lag-vol baselines in curated review."
    },
    {
      "metric": "r2",
      "reference_value": 0.85,
      "higher_is_better": true,
      "source": "synthetic-lit-baseline / example review",
      "note": "Illustrative out-of-sample R2 for linear volatility proxies."
    }
  ],
  "enrich_discussion_with_llm": false,
  "robustness": {
    "vif": true,
    "residual_diagnostics": true,
    "confusion_matrix": false,
    "classification_report": false
  }
